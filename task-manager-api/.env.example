# Local MongoDB connection
MONGO_URI=mongodb://localhost:27017/taskmanager
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=super_secret_placeholder_change_me
JWT_EXPIRES_IN=1h

# Practical 9: Caching Configurations
# CACHE_ENABLED flag lets us bypass the cache completely to measure uncached vs cached performance
CACHE_ENABLED=true
CACHE_TTL=60
LOG_CACHE=false
